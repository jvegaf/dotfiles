#compdef aur-scan

autoload -U is-at-least

_aur-scan() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_aur-scan_commands" \
"*::: :->aur-scan" \
&& ret=0
    case $state in
    (aur-scan)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:aur-scan-command-$line[1]:"
        case $line[1] in
            (scan)
_arguments "${_arguments_options[@]}" : \
'-f+[Output format]:FORMAT:(text json sarif)' \
'--format=[Output format]:FORMAT:(text json sarif)' \
'-o+[Output file (stdout if not specified)]:OUTPUT:_files' \
'--output=[Output file (stdout if not specified)]:OUTPUT:_files' \
'--fail-on=[Exit with non-zero code if findings at or above this severity]:FAIL_ON:(critical high medium low info)' \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--include-info[Include informational findings]' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
':path -- Path to PKGBUILD or directory containing it:_files' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--fail-on=[Exit with non-zero code if findings at or above this severity]:FAIL_ON:(critical high medium low info)' \
'--sbom=[Write a CycloneDX SBOM of the full dependency tree to this path]:FILE:_files' \
'*--local=[Scan these already-fetched package dir(s) from disk (race-free, the exact bytes that will be built). Repeatable. Remaining AUR deps are fetched from the AUR unless they are also provided here]:DIR:_files' \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--no-confirm[Skip interactive prompt (don'\''t ask to proceed)]' \
'--no-deps[Do not resolve and scan the AUR dependency tree (named packages only)]' \
'--include-optional[Also follow optional dependencies when resolving the tree]' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::packages -- Package name(s) to check (optional if --local dirs are given):_default' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--gate=[Gate threshold\: findings at or above this severity block the build]:GATE:(critical high medium low info)' \
'--workspace=[Workspace dir for clones/builds (default ~/.cache/aur-scan/build)]:DIR:_files' \
'--sbom=[Write a CycloneDX SBOM to this path]:FILE:_files' \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--include-optional[Also follow optional dependencies]' \
'--noconfirm[Pass --noconfirm to makepkg and skip the build prompt]' \
'--force[Build even if the scan gate trips (deliberate override)]' \
'--keep-build[Keep the build directories after a successful install (default\: clean them up)]' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::packages -- Package name(s) to install:_default' \
&& ret=0
;;
(system)
