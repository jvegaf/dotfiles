'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--rescan[Re-fetch PKGBUILDs from AUR (instead of using cache)]' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(rules)
_arguments "${_arguments_options[@]}" : \
'-s+[Show only rules of this severity]:SEVERITY:(critical high medium low info)' \
'--severity=[Show only rules of this severity]:SEVERITY:(critical high medium low info)' \
