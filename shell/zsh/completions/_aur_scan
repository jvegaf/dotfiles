'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(version)
_arguments "${_arguments_options[@]}" : \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(diff)
_arguments "${_arguments_options[@]}" : \
'-f+[Output format]:FORMAT:(text json)' \
'--format=[Output format]:FORMAT:(text json)' \
'--fail-on=[Exit non-zero if a NEWLY ADDED finding is at or above this severity. Pre-existing findings never trip this gate]:FAIL_ON:(critical high medium low info)' \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':old -- The older package directory (or PKGBUILD):_files' \
':new -- The newer package directory (or PKGBUILD):_files' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-c+[Configuration file path]:CONFIG:_files' \
'--config=[Configuration file path]:CONFIG:_files' \
'-s+[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'--severity=[Minimum severity to report]:SEVERITY:(critical high medium low info)' \
'-v[Enable verbose output]' \
'--verbose[Enable verbose output]' \
'-q[Quiet mode (only show findings)]' \
'--quiet[Quiet mode (only show findings)]' \
'--no-color[Disable colored output (also honored\: the NO_COLOR environment variable)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to generate completions for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_aur-scan__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:aur-scan-help-command-$line[1]:"
        case $line[1] in
            (scan)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(system)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(rules)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(explain)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(codes)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ioc)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(version)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(diff)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_aur-scan_commands] )) ||
_aur-scan_commands() {
    local commands; commands=(
'scan:Scan a PKGBUILD file or directory' \
'check:Check an AUR package BEFORE installation (fetches from AUR)' \
'install:Race-free install\: scan the exact bytes, then build them in dep order' \
'system:Scan all installed AUR packages on the system' \
'rules:List available detection rules' \
'explain:Explain a detection code in detail' \
'codes:List all detection codes with brief descriptions' \
'ioc:Show or query the IOC (indicator of compromise) database' \
'version:Check scanner version and configuration' \
'diff:Compare two versions of a package and report what changed' \
'completions:Generate a shell completion script for aur-scan' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'aur-scan commands' commands "$@"
}
