    window-rule {
        match app-id=r#"firefox$"# title="^Picture-in-Picture$"
        match app-id="1password"
        match app-id="org.pulseaudio.pavucontrol"
        match app-id="nm-connection-editor"
        match app-id="blueman-manager"
        match app-id="mpv"
        match title="^Welcome to Android Studio$" // xev
        open-floating true // Always float Firefox PiP windows
    }


    window-rule {
        geometry-corner-radius 10 // Set every window radius to 20
        clip-to-geometry true
    }

    // Open Firefox maximized and on the "browser" workspace
    window-rule {
        match app-id="firefox"
        // match app-id="Alacritty"
        match app-id="FreeCAD"
        match app-id="org.QCAD.qcad-bin"
        match app-id="code"
        match app-id="code-insiders"
        match app-id="thunar"
        match app-id="jetbrains-studio"
        match app-id="kicad"

        //open-on-workspace "browser"
        open-maximized true
        // default-column-width {}
    }

    window-rule {
        background-effect {
          blur true
          xray false
        }
    }

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    window-rule {
       match app-id="org.gnome.Nautilus"
       open-floating true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }
